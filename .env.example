# --- Database -------------------------------------------------------
# Railway injects DATABASE_URL automatically when a Postgres plugin is
# attached. For local dev, point this at a local Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flighttracker?schema=public"

# --- FlightAware AeroAPI (flight data + auto inbound detection) -----
# Free tier: ~$5/month in free credits (~1000 queries). Sign up at
# https://flightaware.com/aeroapi. This is required for live data.
FLIGHTAWARE_KEY=""

# --- Optional: Google Maps (drive-time to airport) -----------------
# Used for ETA / traffic to the airport. Free $200/month credit.
# Leave blank to fall back to a static distance estimate.
GOOGLE_MAPS_KEY=""

# --- Optional: Simple shared passcode (gates the whole app) --------
# Anyone with this passcode can use the shared family account.
# Leave blank to skip the gate (open access).
SHARED_PASSCODE=""
